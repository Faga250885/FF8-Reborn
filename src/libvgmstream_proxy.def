    get_vgmstream_frame_size=libvgmstream_orig.get_vgmstream_frame_size @6
    get_vgmstream_play_samples=libvgmstream_orig.get_vgmstream_play_samples @7
    get_vgmstream_samples_per_frame=libvgmstream_orig.get_vgmstream_samples_per_frame @8
    get_vgmstream_samples_per_shortframe=libvgmstream_orig.get_vgmstream_samples_per_shortframe @9
    get_vgmstream_shortframe_size=libvgmstream_orig.get_vgmstream_shortframe_size @10
    init_vgmstream=libvgmstream_orig.init_vgmstream @11
    init_vgmstream_from_STREAMFILE=libvgmstream_orig.init_vgmstream_from_STREAMFILE @12
    render_vgmstream=libvgmstream_orig.render_vgmstream @13
    reset_vgmstream=libvgmstream_orig.reset_vgmstream @14
